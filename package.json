{
  "name": "agent-hub",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "description": "A shared coordination room for coding agents and their teams.",
  "agentHub": {
    "protocolVersion": 1,
    "schemaVersion": 3,
    "minimumSourceProtocolVersion": 1,
    "minimumSourceSchemaVersion": 2
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate:publish": "tsx src/server/publication-gate.ts",
    "desktop:run": "electron dist/desktop/main.js",
    "desktop:pack": "pnpm build && electron-builder --win nsis",
    "desktop:pack:ci": "pnpm build && electron-builder --win nsis --publish never",
    "desktop:dir": "pnpm build && electron-builder --dir",
    "desktop:verify-recovery": "node scripts/verify-packaged-update-recovery.mjs"
  },
  "dependencies": {
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/napi": "0.45.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-updater": "6.8.9",
    "express": "5.2.1",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
